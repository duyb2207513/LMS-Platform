generator client {
  provider            = "prisma-client"
  output              = "../src/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  TEXT
  DOCUMENT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentProvider {
  MOCK
  VNPAY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String     @map("full_name") @db.VarChar(100)
  email        String     @unique @db.VarChar(255)
  passwordHash String?    @map("password_hash")
  avatarUrl    String?    @map("avatar_url")
  googleId     String?    @unique @map("google_id") @db.VarChar(255)
  githubId     String?    @unique @map("github_id") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  failedLoginAttempts Int @default(0) @map("failed_login_attempts")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  courses        Course[]         @relation("InstructorCourses")
  enrollments    Enrollment[]     @relation("StudentEnrollments")
  lessonProgress LessonProgress[] @relation("StudentLessonProgress")
  quizAttempts   QuizAttempt[]    @relation("StudentQuizAttempts")
  reviews        Review[]
  comments       Comment[]
  orders         Order[]
  certificates   Certificate[]
  authSessions   AuthSession[]
  authTokens     AuthToken[]
  auditLogs      AuditLog[]      @relation("AuditActor")

  @@index([role])
  @@index([status])
  @@map("users")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthToken {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  type        AuthTokenType
  tokenHash   String        @unique @map("token_hash") @db.VarChar(64)
  targetEmail String?       @map("target_email") @db.VarChar(255)
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String?  @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.VarChar(100)
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  courses Course[]

  @@map("categories")
}

model Course {
  id               String       @id @default(uuid()) @db.Uuid
  instructorId     String       @map("instructor_id") @db.Uuid
  categoryId       String       @map("category_id") @db.Uuid
  title            String       @db.VarChar(255)
  slug             String       @unique @db.VarChar(255)
  description      String
  thumbnailUrl     String?      @map("thumbnail_url")
  level            CourseLevel
  price            Decimal      @default(0) @db.Decimal(12, 2)
  isFree           Boolean      @default(false) @map("is_free")
  language         String       @default("Vietnamese") @db.VarChar(50)
  requirements     String?
  learningOutcomes String?      @map("learning_outcomes")
  status           CourseStatus @default(DRAFT)
  publishedAt      DateTime?    @map("published_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  instructor User     @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Restrict)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sections    Section[]
  enrollments Enrollment[]
  reviews     Review[]
  orderItems  OrderItem[]
  certificates Certificate[]

  @@index([instructorId])
  @@index([categoryId])
  @@index([status])
  @@index([level])
  @@index([createdAt])
  @@map("courses")
}

model Section {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  title     String   @db.VarChar(255)
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, position])
  @@map("sections")
}

model Lesson {
  id              String     @id @default(uuid()) @db.Uuid
  sectionId       String     @map("section_id") @db.Uuid
  title           String     @db.VarChar(255)
  lessonType      LessonType @map("lesson_type")
  content         String?
  videoUrl        String?    @map("video_url")
  documentUrl     String?    @map("document_url")
  durationSeconds Int?       @map("duration_seconds")
  position        Int
  isPreview       Boolean    @default(false) @map("is_preview")
  isRequired      Boolean    @default(true) @map("is_required")
  isPublished     Boolean    @default(false) @map("is_published")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  section  Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress LessonProgress[]
  quiz     Quiz?
  comments Comment[]

  @@index([sectionId, position])
  @@index([isPublished])
  @@map("lessons")
}

model Enrollment {
  id              String           @id @default(uuid()) @db.Uuid
  studentId       String           @map("student_id") @db.Uuid
  courseId        String           @map("course_id") @db.Uuid
  enrolledAt      DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  completedAt     DateTime?        @map("completed_at") @db.Timestamptz(3)
  progressPercent Decimal          @default(0) @map("progress_percent") @db.Decimal(5, 2)
  status          EnrollmentStatus @default(ACTIVE)

  student User   @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  certificate Certificate?

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

model LessonProgress {
  id                String    @id @default(uuid()) @db.Uuid
  studentId         String    @map("student_id") @db.Uuid
  lessonId          String    @map("lesson_id") @db.Uuid
  isCompleted       Boolean   @default(false) @map("is_completed")
  lastWatchedSecond Int       @default(0) @map("last_watched_second")
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  student User   @relation("StudentLessonProgress", fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model Quiz {
  id               String   @id @default(uuid()) @db.Uuid
  lessonId         String   @unique @map("lesson_id") @db.Uuid
  title            String   @db.VarChar(255)
  description      String?
  passingScore     Int      @default(70) @map("passing_score")
  maxAttempts      Int      @default(3) @map("max_attempts")
  timeLimitMinutes Int?     @map("time_limit_minutes")
  isPublished      Boolean  @default(false) @map("is_published")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  @@index([isPublished])
  @@map("quizzes")
}

model Question {
  id          String   @id @default(uuid()) @db.Uuid
  quizId      String   @map("quiz_id") @db.Uuid
  text        String
  explanation String?
  points      Int      @default(1)
  position    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers AttemptAnswer[]

  @@index([quizId, position])
  @@map("questions")
}

model QuizOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  text       String
  isCorrect  Boolean  @default(false) @map("is_correct")
  position   Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  question Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  @@index([questionId, position])
  @@map("quiz_options")
}

model QuizAttempt {
  id            String            @id @default(uuid()) @db.Uuid
  quizId        String            @map("quiz_id") @db.Uuid
  studentId     String            @map("student_id") @db.Uuid
  attemptNumber Int               @map("attempt_number")
  status        QuizAttemptStatus @default(IN_PROGRESS)
  score         Decimal?          @db.Decimal(5, 2)
  earnedPoints  Int?              @map("earned_points")
  totalPoints   Int?              @map("total_points")
  passed        Boolean?
  startedAt     DateTime          @default(now()) @map("started_at") @db.Timestamptz(3)
  submittedAt   DateTime?         @map("submitted_at") @db.Timestamptz(3)

  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User            @relation("StudentQuizAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]

  @@unique([quizId, studentId, attemptNumber])
  @@index([studentId, quizId])
  @@map("quiz_attempts")
}

model AttemptAnswer {
  id           String  @id @default(uuid()) @db.Uuid
  attemptId    String  @map("attempt_id") @db.Uuid
  questionId   String  @map("question_id") @db.Uuid
  optionId     String  @map("option_id") @db.Uuid
  isCorrect    Boolean @map("is_correct")
  pointsEarned Int     @default(0) @map("points_earned")

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   QuizOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([optionId])
  @@map("attempt_answers")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  rating    Int
  content   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId, createdAt])
  @@map("reviews")
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  lessonId  String    @map("lesson_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  content   String
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson  Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([lessonId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  orderNumber String      @unique @map("order_number") @db.VarChar(32)
  userId      String      @map("user_id") @db.Uuid
  status      OrderStatus @default(PENDING)
  subtotal    Decimal     @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  currency    String      @default("VND") @db.VarChar(3)
  paidAt      DateTime?   @map("paid_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(uuid()) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  courseId            String   @map("course_id") @db.Uuid
  courseTitleSnapshot String   @map("course_title_snapshot") @db.VarChar(255)
  priceSnapshot       Decimal  @map("price_snapshot") @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([orderId, courseId])
  @@index([courseId])
  @@map("order_items")
}

model Payment {
  id                    String          @id @default(uuid()) @db.Uuid
  orderId               String          @map("order_id") @db.Uuid
  provider              PaymentProvider
  status                PaymentStatus   @default(PENDING)
  amount                Decimal         @db.Decimal(12, 2)
  currency              String          @default("VND") @db.VarChar(3)
  idempotencyKey        String          @unique @map("idempotency_key") @db.VarChar(100)
  providerTransactionId String?         @unique @map("provider_transaction_id") @db.VarChar(100)
  failureReason         String?         @map("failure_reason")
  paidAt                DateTime?       @map("paid_at") @db.Timestamptz(3)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  order  Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events PaymentWebhookEvent[]

  @@index([orderId, createdAt])
  @@index([status])
  @@map("payments")
}

model PaymentWebhookEvent {
  id          String          @id @default(uuid()) @db.Uuid
  paymentId   String          @map("payment_id") @db.Uuid
  provider    PaymentProvider
  eventId     String          @map("event_id") @db.VarChar(100)
  payload     Json
  processedAt DateTime        @default(now()) @map("processed_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, eventId])
  @@index([paymentId])
  @@map("payment_webhook_events")
}

model Certificate {
  id                     String    @id @default(uuid()) @db.Uuid
  certificateNumber      String    @unique @map("certificate_number") @db.VarChar(40)
  verificationCode       String    @unique @map("verification_code") @db.VarChar(64)
  enrollmentId           String    @unique @map("enrollment_id") @db.Uuid
  studentId              String    @map("student_id") @db.Uuid
  courseId               String    @map("course_id") @db.Uuid
  studentNameSnapshot    String    @map("student_name_snapshot") @db.VarChar(100)
  courseTitleSnapshot    String    @map("course_title_snapshot") @db.VarChar(255)
  instructorNameSnapshot String    @map("instructor_name_snapshot") @db.VarChar(100)
  issuedAt               DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(3)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId])
  @@index([courseId])
  @@map("certificates")
}
