generator client {
  provider            = "prisma-client"
  output              = "../src/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  TEXT
  DOCUMENT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  REFUNDED
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MOCK
  VNPAY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponUsageStatus {
  REDEEMED
  RELEASED
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  REFUNDED
  FAILED
  CANCELLED
}

enum PaymentRefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum EarningStatus {
  PENDING
  AVAILABLE
  PAID
  REVERSED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL
  MOBILE_OAUTH
}

enum AssignmentSubmissionStatus {
  SUBMITTED
  GRADED
}

enum NotificationType {
  WELCOME
  COURSE_ENROLLED
  NEW_LESSON
  ASSIGNMENT_DUE
  QUIZ_RESULT
  CERTIFICATE_ISSUED
  COURSE_ANNOUNCEMENT
  ASSIGNMENT_GRADED
  PAYMENT_SUCCEEDED
  DIRECT_MESSAGE
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

enum LearningEventType {
  COURSE_OPENED
  LESSON_STARTED
  LESSON_COMPLETED
  QUIZ_STARTED
  QUIZ_SUBMITTED
  STUDY_SESSION
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  fullName            String     @map("full_name") @db.VarChar(100)
  firstName           String?    @map("first_name") @db.VarChar(50)
  lastName            String?    @map("last_name") @db.VarChar(50)
  phoneNumber         String?    @unique @map("phone_number") @db.VarChar(20)
  email               String     @unique @db.VarChar(255)
  passwordHash        String?    @map("password_hash")
  avatarUrl           String?    @map("avatar_url")
  googleId            String?    @unique @map("google_id") @db.VarChar(255)
  githubId            String?    @unique @map("github_id") @db.VarChar(255)
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(3)
  role                UserRole   @default(STUDENT)
  status              UserStatus @default(ACTIVE)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  courses                Course[]                @relation("InstructorCourses")
  enrollments            Enrollment[]            @relation("StudentEnrollments")
  lessonProgress         LessonProgress[]        @relation("StudentLessonProgress")
  quizAttempts           QuizAttempt[]           @relation("StudentQuizAttempts")
  assignmentSubmissions  AssignmentSubmission[]  @relation("StudentAssignmentSubmissions")
  submissionFeedback     SubmissionFeedback[]    @relation("GraderSubmissionFeedback")
  reviews                Review[]
  comments               Comment[]
  orders                 Order[]
  certificates           Certificate[]
  authSessions           AuthSession[]
  authTokens             AuthToken[]
  auditLogs              AuditLog[]              @relation("AuditActor")
  notifications          Notification[]
  notificationPreference NotificationPreference?
  pushDevices            PushDevice[]
  emailLogs              EmailLog[]
  courseAnnouncements    CourseAnnouncement[]    @relation("AnnouncementAuthor")
  learningEvents         LearningEvent[]
  videoWatchEvents       VideoWatchEvent[]
  couponsCreated         Coupon[]               @relation("CouponCreator")
  couponUsages           CouponUsage[]
  refundRequests         RefundRequest[]         @relation("RefundRequester")
  refundReviews          RefundRequest[]         @relation("RefundReviewer")
  instructorEarnings     InstructorEarning[]     @relation("InstructorEarnings")
  instructorPayouts      Payout[]                @relation("InstructorPayouts")
  payoutsCreated         Payout[]                @relation("PayoutCreator")
  sentMessages           DirectMessage[]         @relation("SentDirectMessages")
  receivedMessages       DirectMessage[]         @relation("ReceivedDirectMessages")

  @@index([role])
  @@index([status])
  @@map("users")
}

model DirectMessage {
  id          String    @id @default(uuid()) @db.Uuid
  senderId    String    @map("sender_id") @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  content     String
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sender    User @relation("SentDirectMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedDirectMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt(sort: Desc)])
  @@index([recipientId, readAt, createdAt(sort: Desc)])
  @@map("direct_messages")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthToken {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  type        AuthTokenType
  tokenHash   String        @unique @map("token_hash") @db.VarChar(64)
  targetEmail String?       @map("target_email") @db.VarChar(255)
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String?  @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.VarChar(100)
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  courses Course[]

  @@map("categories")
}

model Course {
  id               String       @id @default(uuid()) @db.Uuid
  instructorId     String       @map("instructor_id") @db.Uuid
  categoryId       String       @map("category_id") @db.Uuid
  title            String       @db.VarChar(255)
  slug             String       @unique @db.VarChar(255)
  description      String
  thumbnailUrl     String?      @map("thumbnail_url")
  level            CourseLevel
  price            Decimal      @default(0) @db.Decimal(12, 2)
  isFree           Boolean      @default(false) @map("is_free")
  language         String       @default("Vietnamese") @db.VarChar(50)
  requirements     String?
  learningOutcomes String?      @map("learning_outcomes")
  status           CourseStatus @default(DRAFT)
  publishedAt      DateTime?    @map("published_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  instructor       User                 @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Restrict)
  category         Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sections         Section[]
  enrollments      Enrollment[]
  reviews          Review[]
  orderItems       OrderItem[]
  certificates     Certificate[]
  assignments      Assignment[]
  gradeRule        CourseGradeRule?
  announcements    CourseAnnouncement[]
  learningEvents   LearningEvent[]
  videoWatchEvents VideoWatchEvent[]
  couponCourses    CouponCourse[]
  earnings         InstructorEarning[]

  @@index([instructorId])
  @@index([categoryId])
  @@index([status])
  @@index([level])
  @@index([createdAt])
  @@map("courses")
}

model Section {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  title     String   @db.VarChar(255)
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, position])
  @@map("sections")
}

model Lesson {
  id              String     @id @default(uuid()) @db.Uuid
  sectionId       String     @map("section_id") @db.Uuid
  title           String     @db.VarChar(255)
  lessonType      LessonType @map("lesson_type")
  content         String?
  videoUrl        String?    @map("video_url")
  documentUrl     String?    @map("document_url")
  durationSeconds Int?       @map("duration_seconds")
  position        Int
  isPreview       Boolean    @default(false) @map("is_preview")
  isRequired      Boolean    @default(true) @map("is_required")
  isPublished     Boolean    @default(false) @map("is_published")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  section          Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress         LessonProgress[]
  quiz             Quiz?
  comments         Comment[]
  learningEvents   LearningEvent[]
  videoWatchEvents VideoWatchEvent[]

  @@index([sectionId, position])
  @@index([isPublished])
  @@map("lessons")
}

model Enrollment {
  id              String           @id @default(uuid()) @db.Uuid
  studentId       String           @map("student_id") @db.Uuid
  courseId        String           @map("course_id") @db.Uuid
  enrolledAt      DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  completedAt     DateTime?        @map("completed_at") @db.Timestamptz(3)
  progressPercent Decimal          @default(0) @map("progress_percent") @db.Decimal(5, 2)
  status          EnrollmentStatus @default(ACTIVE)

  student     User         @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  certificate Certificate?

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

model LessonProgress {
  id                String    @id @default(uuid()) @db.Uuid
  studentId         String    @map("student_id") @db.Uuid
  lessonId          String    @map("lesson_id") @db.Uuid
  isCompleted       Boolean   @default(false) @map("is_completed")
  lastWatchedSecond Int       @default(0) @map("last_watched_second")
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  student User   @relation("StudentLessonProgress", fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model Quiz {
  id               String   @id @default(uuid()) @db.Uuid
  lessonId         String   @unique @map("lesson_id") @db.Uuid
  title            String   @db.VarChar(255)
  description      String?
  passingScore     Int      @default(70) @map("passing_score")
  maxAttempts      Int      @default(3) @map("max_attempts")
  timeLimitMinutes Int?     @map("time_limit_minutes")
  isPublished      Boolean  @default(false) @map("is_published")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  @@index([isPublished])
  @@map("quizzes")
}

model Question {
  id          String   @id @default(uuid()) @db.Uuid
  quizId      String   @map("quiz_id") @db.Uuid
  text        String
  explanation String?
  points      Int      @default(1)
  position    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers AttemptAnswer[]

  @@index([quizId, position])
  @@map("questions")
}

model QuizOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  text       String
  isCorrect  Boolean  @default(false) @map("is_correct")
  position   Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  @@index([questionId, position])
  @@map("quiz_options")
}

model QuizAttempt {
  id            String            @id @default(uuid()) @db.Uuid
  quizId        String            @map("quiz_id") @db.Uuid
  studentId     String            @map("student_id") @db.Uuid
  attemptNumber Int               @map("attempt_number")
  status        QuizAttemptStatus @default(IN_PROGRESS)
  score         Decimal?          @db.Decimal(5, 2)
  earnedPoints  Int?              @map("earned_points")
  totalPoints   Int?              @map("total_points")
  passed        Boolean?
  startedAt     DateTime          @default(now()) @map("started_at") @db.Timestamptz(3)
  submittedAt   DateTime?         @map("submitted_at") @db.Timestamptz(3)

  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User            @relation("StudentQuizAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]

  @@unique([quizId, studentId, attemptNumber])
  @@index([studentId, quizId])
  @@map("quiz_attempts")
}

model AttemptAnswer {
  id           String  @id @default(uuid()) @db.Uuid
  attemptId    String  @map("attempt_id") @db.Uuid
  questionId   String  @map("question_id") @db.Uuid
  optionId     String  @map("option_id") @db.Uuid
  isCorrect    Boolean @map("is_correct")
  pointsEarned Int     @default(0) @map("points_earned")

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   QuizOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([optionId])
  @@map("attempt_answers")
}

model Assignment {
  id                   String   @id @default(uuid()) @db.Uuid
  courseId             String   @map("course_id") @db.Uuid
  title                String   @db.VarChar(255)
  description          String?
  instructions         String?
  dueAt                DateTime @map("due_at") @db.Timestamptz(3)
  maxScore             Decimal  @default(100) @map("max_score") @db.Decimal(8, 2)
  allowResubmission    Boolean  @default(false) @map("allow_resubmission")
  maxSubmissions       Int      @default(1) @map("max_submissions")
  allowLateSubmissions Boolean  @default(false) @map("allow_late_submissions")
  isPublished          Boolean  @default(false) @map("is_published")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([courseId, dueAt])
  @@index([isPublished])
  @@map("assignments")
}

model AssignmentSubmission {
  id            String                     @id @default(uuid()) @db.Uuid
  assignmentId  String                     @map("assignment_id") @db.Uuid
  studentId     String                     @map("student_id") @db.Uuid
  attemptNumber Int                        @map("attempt_number")
  textContent   String?                    @map("text_content")
  status        AssignmentSubmissionStatus @default(SUBMITTED)
  submittedAt   DateTime                   @default(now()) @map("submitted_at") @db.Timestamptz(3)
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignment Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User                @relation("StudentAssignmentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  files      SubmissionFile[]
  feedback   SubmissionFeedback?

  @@unique([assignmentId, studentId, attemptNumber])
  @@index([assignmentId, submittedAt])
  @@index([studentId, submittedAt])
  @@map("assignment_submissions")
}

model SubmissionFile {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  originalName String   @map("original_name") @db.VarChar(255)
  storedName   String   @map("stored_name") @db.VarChar(255)
  fileUrl      String   @map("file_url")
  mimeType     String   @map("mime_type") @db.VarChar(150)
  sizeBytes    Int      @map("size_bytes")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("submission_files")
}

model SubmissionFeedback {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @unique @map("submission_id") @db.Uuid
  graderId     String   @map("grader_id") @db.Uuid
  score        Decimal  @db.Decimal(8, 2)
  comment      String?
  gradedAt     DateTime @default(now()) @map("graded_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  grader     User                 @relation("GraderSubmissionFeedback", fields: [graderId], references: [id], onDelete: Restrict)

  @@index([graderId, gradedAt])
  @@map("submission_feedback")
}

model CourseGradeRule {
  id               String   @id @default(uuid()) @db.Uuid
  courseId         String   @unique @map("course_id") @db.Uuid
  assignmentWeight Decimal  @default(60) @map("assignment_weight") @db.Decimal(5, 2)
  quizWeight       Decimal  @default(40) @map("quiz_weight") @db.Decimal(5, 2)
  passingScore     Decimal  @default(70) @map("passing_score") @db.Decimal(5, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_grade_rules")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(255)
  message   String
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  inAppEnabled        Boolean  @default(true) @map("in_app_enabled")
  emailEnabled        Boolean  @default(true) @map("email_enabled")
  pushEnabled         Boolean  @default(true) @map("push_enabled")
  courseUpdates       Boolean  @default(true) @map("course_updates")
  assignmentReminders Boolean  @default(true) @map("assignment_reminders")
  quizResults         Boolean  @default(true) @map("quiz_results")
  certificateUpdates  Boolean  @default(true) @map("certificate_updates")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model PushDevice {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  expoPushToken String   @unique @map("expo_push_token") @db.VarChar(255)
  platform     String    @db.VarChar(20)
  deviceName   String?   @map("device_name") @db.VarChar(120)
  isActive     Boolean   @default(true) @map("is_active")
  lastUsedAt   DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("push_devices")
}

model EmailLog {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String?     @map("user_id") @db.Uuid
  toEmail      String      @map("to_email") @db.VarChar(255)
  subject      String      @db.VarChar(255)
  template     String      @db.VarChar(100)
  status       EmailStatus @default(PENDING)
  errorMessage String?     @map("error_message")
  sentAt       DateTime?   @map("sent_at") @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("email_logs")
}

model CourseAnnouncement {
  id          String             @id @default(uuid()) @db.Uuid
  courseId    String             @map("course_id") @db.Uuid
  authorId    String             @map("author_id") @db.Uuid
  title       String             @db.VarChar(255)
  content     String
  status      AnnouncementStatus @default(DRAFT)
  publishedAt DateTime?          @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author User   @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([courseId, status, publishedAt(sort: Desc)])
  @@index([authorId])
  @@map("course_announcements")
}

model LearningEvent {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  courseId        String            @map("course_id") @db.Uuid
  lessonId        String?           @map("lesson_id") @db.Uuid
  eventType       LearningEventType @map("event_type")
  sessionId       String            @map("session_id") @db.Uuid
  durationSeconds Int?              @map("duration_seconds")
  metadata        Json?
  occurredAt      DateTime          @map("occurred_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId, eventType, occurredAt])
  @@index([userId, occurredAt])
  @@index([courseId, occurredAt])
  @@index([lessonId, eventType])
  @@index([userId, courseId, occurredAt])
  @@map("learning_events")
}

model VideoWatchEvent {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  courseId             String    @map("course_id") @db.Uuid
  lessonId             String    @map("lesson_id") @db.Uuid
  sessionId            String    @map("session_id") @db.Uuid
  startedAt            DateTime  @map("started_at") @db.Timestamptz(3)
  endedAt              DateTime? @map("ended_at") @db.Timestamptz(3)
  startPositionSeconds Int       @map("start_position_seconds")
  endPositionSeconds   Int?      @map("end_position_seconds")
  watchedSeconds       Int       @map("watched_seconds")
  completed            Boolean   @default(false)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId, startedAt])
  @@index([userId, lessonId, startedAt])
  @@index([courseId, lessonId])
  @@index([userId, courseId, startedAt])
  @@map("video_watch_events")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  rating    Int
  content   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId, createdAt])
  @@map("reviews")
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  lessonId  String    @map("lesson_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  content   String
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson  Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([lessonId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  orderNumber String      @unique @map("order_number") @db.VarChar(32)
  userId      String      @map("user_id") @db.Uuid
  status      OrderStatus @default(PENDING)
  subtotal    Decimal     @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  currency    String      @default("VND") @db.VarChar(3)
  paidAt      DateTime?   @map("paid_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]
  couponId  String?       @map("coupon_id") @db.Uuid
  discount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  coupon    Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponUsage CouponUsage?
  refundRequests RefundRequest[]
  earnings  InstructorEarning[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(uuid()) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  courseId            String   @map("course_id") @db.Uuid
  courseTitleSnapshot String   @map("course_title_snapshot") @db.VarChar(255)
  priceSnapshot       Decimal  @map("price_snapshot") @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  earning InstructorEarning?

  @@unique([orderId, courseId])
  @@index([courseId])
  @@map("order_items")
}

model Payment {
  id                    String          @id @default(uuid()) @db.Uuid
  orderId               String          @map("order_id") @db.Uuid
  provider              PaymentProvider
  status                PaymentStatus   @default(PENDING)
  amount                Decimal         @db.Decimal(12, 2)
  currency              String          @default("VND") @db.VarChar(3)
  idempotencyKey        String          @unique @map("idempotency_key") @db.VarChar(100)
  providerTransactionId String?         @unique @map("provider_transaction_id") @db.VarChar(100)
  failureReason         String?         @map("failure_reason")
  paidAt                DateTime?       @map("paid_at") @db.Timestamptz(3)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  order  Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events PaymentWebhookEvent[]
  refundRequests RefundRequest[]
  refunds PaymentRefund[]
  earnings InstructorEarning[]

  @@index([orderId, createdAt])
  @@index([status])
  @@map("payments")
}

model PaymentWebhookEvent {
  id          String          @id @default(uuid()) @db.Uuid
  paymentId   String          @map("payment_id") @db.Uuid
  provider    PaymentProvider
  eventId     String          @map("event_id") @db.VarChar(100)
  payload     Json
  processedAt DateTime        @default(now()) @map("processed_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, eventId])
  @@index([paymentId])
  @@map("payment_webhook_events")
}

model Certificate {
  id                     String    @id @default(uuid()) @db.Uuid
  certificateNumber      String    @unique @map("certificate_number") @db.VarChar(40)
  verificationCode       String    @unique @map("verification_code") @db.VarChar(64)
  enrollmentId           String    @unique @map("enrollment_id") @db.Uuid
  studentId              String    @map("student_id") @db.Uuid
  courseId               String    @map("course_id") @db.Uuid
  studentNameSnapshot    String    @map("student_name_snapshot") @db.VarChar(100)
  courseTitleSnapshot    String    @map("course_title_snapshot") @db.VarChar(255)
  instructorNameSnapshot String    @map("instructor_name_snapshot") @db.VarChar(100)
  issuedAt               DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(3)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId])
  @@index([courseId])
  @@map("certificates")
}

model Coupon {
  id                    String             @id @default(uuid()) @db.Uuid
  code                  String             @unique @db.VarChar(50)
  name                  String             @db.VarChar(255)
  description           String?
  discountType          CouponDiscountType @map("discount_type")
  discountValue         Decimal            @map("discount_value") @db.Decimal(12, 2)
  maxDiscountAmount     Decimal?           @map("max_discount_amount") @db.Decimal(12, 2)
  minOrderAmount        Decimal?           @map("min_order_amount") @db.Decimal(12, 2)
  startsAt              DateTime           @map("starts_at") @db.Timestamptz(3)
  expiresAt             DateTime           @map("expires_at") @db.Timestamptz(3)
  maxRedemptions        Int?               @map("max_redemptions")
  redeemedCount         Int                @default(0) @map("redeemed_count")
  appliesToAllCourses   Boolean            @default(false) @map("applies_to_all_courses")
  isActive              Boolean            @default(true) @map("is_active")
  createdById           String             @map("created_by") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User          @relation("CouponCreator", fields: [createdById], references: [id], onDelete: Restrict)
  courses   CouponCourse[]
  usages    CouponUsage[]
  orders    Order[]

  @@index([isActive, startsAt, expiresAt])
  @@map("coupons")
}

model CouponCourse {
  couponId String   @map("coupon_id") @db.Uuid
  courseId String   @map("course_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([couponId, courseId])
  @@index([courseId])
  @@map("coupon_courses")
}

model CouponUsage {
  id             String            @id @default(uuid()) @db.Uuid
  couponId       String            @map("coupon_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  orderId        String            @unique @map("order_id") @db.Uuid
  discountAmount Decimal           @map("discount_amount") @db.Decimal(12, 2)
  status         CouponUsageStatus @default(REDEEMED)
  usedAt         DateTime?         @map("used_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([couponId, userId])
  @@index([couponId, status])
  @@map("coupon_usages")
}

model RefundRequest {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  orderId         String              @map("order_id") @db.Uuid
  paymentId       String              @map("payment_id") @db.Uuid
  reason          String
  status          RefundRequestStatus @default(PENDING)
  requestedAmount Decimal             @map("requested_amount") @db.Decimal(12, 2)
  approvedAmount  Decimal?            @map("approved_amount") @db.Decimal(12, 2)
  adminNote       String?             @map("admin_note")
  reviewedById    String?             @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?           @map("reviewed_at") @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User    @relation("RefundRequester", fields: [userId], references: [id], onDelete: Restrict)
  reviewer  User?   @relation("RefundReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refunds   PaymentRefund[]

  @@index([userId, createdAt])
  @@index([paymentId, status])
  @@index([status, createdAt])
  @@map("refund_requests")
}

model PaymentRefund {
  id                String              @id @default(uuid()) @db.Uuid
  refundRequestId   String              @map("refund_request_id") @db.Uuid
  paymentId         String              @map("payment_id") @db.Uuid
  providerRefundId  String?             @unique @map("provider_refund_id") @db.VarChar(255)
  idempotencyKey    String              @unique @map("idempotency_key") @db.VarChar(255)
  amount            Decimal             @db.Decimal(12, 2)
  status            PaymentRefundStatus @default(PENDING)
  failureReason     String?             @map("failure_reason")
  processedAt       DateTime?           @map("processed_at") @db.Timestamptz(3)
  providerPayload   Json?               @map("provider_payload")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  refundRequest RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Restrict)
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([refundRequestId])
  @@index([paymentId, status])
  @@map("payment_refunds")
}

model InstructorEarning {
  id                String        @id @default(uuid()) @db.Uuid
  instructorId      String        @map("instructor_id") @db.Uuid
  courseId          String        @map("course_id") @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  orderItemId       String        @unique @map("order_item_id") @db.Uuid
  paymentId         String        @map("payment_id") @db.Uuid
  grossAmount       Decimal       @map("gross_amount") @db.Decimal(12, 2)
  platformFeeRate   Decimal       @map("platform_fee_rate") @db.Decimal(5, 2)
  platformFeeAmount Decimal       @map("platform_fee_amount") @db.Decimal(12, 2)
  netAmount         Decimal       @map("net_amount") @db.Decimal(12, 2)
  currency          String        @default("VND") @db.VarChar(3)
  status            EarningStatus @default(PENDING)
  availableAt       DateTime      @map("available_at") @db.Timestamptz(3)
  payoutId          String?       @map("payout_id") @db.Uuid
  reversedAt        DateTime?     @map("reversed_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  instructor User      @relation("InstructorEarnings", fields: [instructorId], references: [id], onDelete: Restrict)
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem  OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  payment    Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  payout     Payout?   @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([instructorId, status, availableAt])
  @@index([courseId, createdAt])
  @@index([orderId])
  @@map("instructor_earnings")
}

model Payout {
  id                String       @id @default(uuid()) @db.Uuid
  instructorId      String       @map("instructor_id") @db.Uuid
  amount            Decimal      @db.Decimal(12, 2)
  currency          String       @default("VND") @db.VarChar(3)
  status            PayoutStatus @default(PENDING)
  providerReference String?      @unique @map("provider_reference") @db.VarChar(255)
  failureReason     String?      @map("failure_reason")
  createdById       String       @map("created_by") @db.Uuid
  idempotencyKey    String       @unique @map("idempotency_key") @db.VarChar(255)
  processedAt       DateTime?    @map("processed_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  instructor User                @relation("InstructorPayouts", fields: [instructorId], references: [id], onDelete: Restrict)
  createdBy  User                @relation("PayoutCreator", fields: [createdById], references: [id], onDelete: Restrict)
  earnings   InstructorEarning[]

  @@index([instructorId, status, createdAt])
  @@map("payouts")
}
