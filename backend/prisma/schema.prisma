generator client {
  provider            = "prisma-client"
  output              = "../src/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  TEXT
  DOCUMENT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String     @map("full_name") @db.VarChar(100)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash")
  avatarUrl    String?    @map("avatar_url")
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  courses        Course[]         @relation("InstructorCourses")
  enrollments    Enrollment[]     @relation("StudentEnrollments")
  lessonProgress LessonProgress[] @relation("StudentLessonProgress")
  quizAttempts   QuizAttempt[]    @relation("StudentQuizAttempts")
  reviews        Review[]
  comments       Comment[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  courses Course[]

  @@map("categories")
}

model Course {
  id               String       @id @default(uuid()) @db.Uuid
  instructorId     String       @map("instructor_id") @db.Uuid
  categoryId       String       @map("category_id") @db.Uuid
  title            String       @db.VarChar(255)
  slug             String       @unique @db.VarChar(255)
  description      String
  thumbnailUrl     String?      @map("thumbnail_url")
  level            CourseLevel
  price            Decimal      @default(0) @db.Decimal(12, 2)
  isFree           Boolean      @default(false) @map("is_free")
  language         String       @default("Vietnamese") @db.VarChar(50)
  requirements     String?
  learningOutcomes String?      @map("learning_outcomes")
  status           CourseStatus @default(DRAFT)
  publishedAt      DateTime?    @map("published_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  instructor User     @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Restrict)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sections    Section[]
  enrollments Enrollment[]
  reviews     Review[]

  @@index([instructorId])
  @@index([categoryId])
  @@index([status])
  @@index([level])
  @@index([createdAt])
  @@map("courses")
}

model Section {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  title     String   @db.VarChar(255)
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, position])
  @@map("sections")
}

model Lesson {
  id              String     @id @default(uuid()) @db.Uuid
  sectionId       String     @map("section_id") @db.Uuid
  title           String     @db.VarChar(255)
  lessonType      LessonType @map("lesson_type")
  content         String?
  videoUrl        String?    @map("video_url")
  documentUrl     String?    @map("document_url")
  durationSeconds Int?       @map("duration_seconds")
  position        Int
  isPreview       Boolean    @default(false) @map("is_preview")
  isRequired      Boolean    @default(true) @map("is_required")
  isPublished     Boolean    @default(false) @map("is_published")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  section  Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress LessonProgress[]
  quiz     Quiz?
  comments Comment[]

  @@index([sectionId, position])
  @@index([isPublished])
  @@map("lessons")
}

model Enrollment {
  id              String           @id @default(uuid()) @db.Uuid
  studentId       String           @map("student_id") @db.Uuid
  courseId        String           @map("course_id") @db.Uuid
  enrolledAt      DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  completedAt     DateTime?        @map("completed_at") @db.Timestamptz(3)
  progressPercent Decimal          @default(0) @map("progress_percent") @db.Decimal(5, 2)
  status          EnrollmentStatus @default(ACTIVE)

  student User   @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

model LessonProgress {
  id                String    @id @default(uuid()) @db.Uuid
  studentId         String    @map("student_id") @db.Uuid
  lessonId          String    @map("lesson_id") @db.Uuid
  isCompleted       Boolean   @default(false) @map("is_completed")
  lastWatchedSecond Int       @default(0) @map("last_watched_second")
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  student User   @relation("StudentLessonProgress", fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model Quiz {
  id               String   @id @default(uuid()) @db.Uuid
  lessonId         String   @unique @map("lesson_id") @db.Uuid
  title            String   @db.VarChar(255)
  description      String?
  passingScore     Int      @default(70) @map("passing_score")
  maxAttempts      Int      @default(3) @map("max_attempts")
  timeLimitMinutes Int?     @map("time_limit_minutes")
  isPublished      Boolean  @default(false) @map("is_published")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  @@index([isPublished])
  @@map("quizzes")
}

model Question {
  id          String   @id @default(uuid()) @db.Uuid
  quizId      String   @map("quiz_id") @db.Uuid
  text        String
  explanation String?
  points      Int      @default(1)
  position    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers AttemptAnswer[]

  @@index([quizId, position])
  @@map("questions")
}

model QuizOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  text       String
  isCorrect  Boolean  @default(false) @map("is_correct")
  position   Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  question Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  @@index([questionId, position])
  @@map("quiz_options")
}

model QuizAttempt {
  id            String            @id @default(uuid()) @db.Uuid
  quizId        String            @map("quiz_id") @db.Uuid
  studentId     String            @map("student_id") @db.Uuid
  attemptNumber Int               @map("attempt_number")
  status        QuizAttemptStatus @default(IN_PROGRESS)
  score         Decimal?          @db.Decimal(5, 2)
  earnedPoints  Int?              @map("earned_points")
  totalPoints   Int?              @map("total_points")
  passed        Boolean?
  startedAt     DateTime          @default(now()) @map("started_at") @db.Timestamptz(3)
  submittedAt   DateTime?         @map("submitted_at") @db.Timestamptz(3)

  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User            @relation("StudentQuizAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]

  @@unique([quizId, studentId, attemptNumber])
  @@index([studentId, quizId])
  @@map("quiz_attempts")
}

model AttemptAnswer {
  id           String  @id @default(uuid()) @db.Uuid
  attemptId    String  @map("attempt_id") @db.Uuid
  questionId   String  @map("question_id") @db.Uuid
  optionId     String  @map("option_id") @db.Uuid
  isCorrect    Boolean @map("is_correct")
  pointsEarned Int     @default(0) @map("points_earned")

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   QuizOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([optionId])
  @@map("attempt_answers")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  rating    Int
  content   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId, createdAt])
  @@map("reviews")
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  lessonId  String    @map("lesson_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  content   String
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson  Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([lessonId, createdAt])
  @@index([parentId])
  @@map("comments")
}
