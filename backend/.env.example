DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lms_db"
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:5173"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-secret"
MOCK_PAYMENT_WEBHOOK_SECRET="replace-with-a-mock-webhook-secret"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
REQUIRE_EMAIL_VERIFICATION=false
GOOGLE_CLIENT_ID=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3000/api/v1/auth/github/callback"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="LMS Platform <no-reply@example.com>"
SENTRY_DSN=""
LOG_LEVEL=debug
